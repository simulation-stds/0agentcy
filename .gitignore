# Runtime folders: keep placeholders, ignore user/generated contents.
input/*
!input/.gitkeep
output/*
!output/.gitkeep
temp/*
!temp/.gitkeep
tools/*
!tools/.gitkeep

# Local settings and secrets.
app_settings.local.json
*.local
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
*.crt
*.cert

# Logs.
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Python/Conda/cache artifacts.
.venv/
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
conda-meta/

# Large media scratch/export files.
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.gif
*.apng
*.wav
!app/src/assets/sounds/*.wav
*.mp3
*.flac
*.aac
*.m4a
*.ogg

# Local app databases/caches.
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal

# Graphify state belongs to each local checkout.
graphify-out/
graphify-out-windows/
.graphify_*.json
.graphify_*.txt

# OS/editor files.
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Machine-local shared Python runtime configuration
shared-runtimes.local.json

# Task checkouts and machine-local evidence.
/worktrees/
/profiles/*.local.json
/private-test-evidence/
/design/screenshots/

# Local Python environments and generated coverage.
/.graphify-venv/
/.comparison-venv/
.coverage
.coverage.*
htmlcov/
coverage/

# Editable identity source retained locally pending asset review.
/Identity/Artboard-1.vectorcraft
