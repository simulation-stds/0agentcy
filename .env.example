# Copy this file to .env.local and fill only the backend you want to use.
# Do not commit .env.local.

# Graphify CLI path used by docs/scripts on this Windows machine.
GRAPHIFY_EXE=%APPDATA%\Python\Python310\Scripts\graphify.exe

# Default local backend.
GRAPHIFY_BACKEND=ollama

# Ollama runs globally as a local service and can be shared by all projects.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5-coder:7b
# Ollama does not require a real key. Graphify only checks this to suppress a remote-endpoint warning.
OLLAMA_API_KEY=ollama

# Optional extraction tuning.
GRAPHIFY_API_TIMEOUT=900
GRAPHIFY_MAX_WORKERS=
GRAPHIFY_MAX_OUTPUT_TOKENS=

# Native OpenAI backend. Leave blank when using Ollama.
OPENAI_API_KEY=
GRAPHIFY_OPENAI_MODEL=

# Other supported Graphify backends.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
GRAPHIFY_DEEPSEEK_MODEL=deepseek-v4-flash
MOONSHOT_API_KEY=
